-- ================= SAVE / LOAD SETTINGS =================
local SETTINGS_FOLDER = "PHNHUB"
local SETTINGS_FILE = SETTINGS_FOLDER .. "/settings.json"

local function notify(title, content)
	if UI.ToastLabel and UI.ToastLabel.Parent then
		UI.ToastLabel.Text = string.format("%s: %s", title, content)
		UI.ToastLabel.Visible = true
		task.delay(3, function()
			if UI.ToastLabel and UI.ToastLabel.Parent then
				UI.ToastLabel.Visible = false
			end
		end)
	end
end

local function saveSettings()
	if not HasFileSystem then
		notify("PHN HUB", tr("NoFS"))
		return false
	end
	if not isfolder(SETTINGS_FOLDER) then
		pcall(makefolder, SETTINGS_FOLDER)
	end
	local data = {}
	for k, v in pairs(Config) do
		local t = type(v)
		if t == "number" or t == "boolean" or t == "string" then
			data[k] = v
		end
	end
	local ok, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then
		notify("PHN HUB", tr("EncodeErr"))
		return false
	end
	local wrote = pcall(writefile, SETTINGS_FILE, json)
	notify("PHN HUB", wrote and tr("SaveOk") or tr("SaveFail"))
	return wrote
end

local function loadSettings(silent)
	if not HasFileSystem or not isfile(SETTINGS_FILE) then
		if not silent then notify("PHN HUB", tr("NoFile")) end
		return false
	end
	local ok, raw = pcall(readfile, SETTINGS_FILE)
	if not ok then return false end
	local decOk, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not decOk or type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		if DefaultConfig[k] ~= nil and type(v) == type(DefaultConfig[k]) then
			Config[k] = v
		end
	end
	if Config.Language ~= "VI" and Config.Language ~= "EN" then
		Config.Language = "VI"
	end
	if not silent then notify("PHN HUB", tr("LoadOk")) end
	return true
end

if Config.AutoLoadSettings then
	pcall(loadSettings, true)
end

