-- ================= CLEANUP =================
local connections = {}
local drawings = {}
local instances = {}
local extraCleanup = {}

local function trackConn(conn)
	if conn then table.insert(connections, conn) end
	return conn
end

local function trackDraw(obj)
	if obj then table.insert(drawings, obj) end
	return obj
end

local function trackInst(obj)
	if obj then table.insert(instances, obj) end
	return obj
end

local function cleanup(fullUnload)
	if fullUnload == nil then fullUnload = true end
	for _, conn in ipairs(connections) do
		if conn and conn.Connected then
			pcall(function() conn:Disconnect() end)
		end
	end
	for _, draw in ipairs(drawings) do
		pcall(function() draw:Remove() end)
	end
	for _, inst in ipairs(instances) do
		pcall(function() inst:Destroy() end)
	end
	for _, fn in ipairs(extraCleanup) do
		pcall(fn)
	end
	table.clear(connections)
	table.clear(drawings)
	table.clear(instances)
	table.clear(extraCleanup)

	if fullUnload then
		local env = (getgenv and getgenv()) or _G
		env.PHNHubCleanup = nil
	end
end

local env = (getgenv and getgenv()) or _G
if env.PHNHubCleanup then
	pcall(env.PHNHubCleanup, false)
end

