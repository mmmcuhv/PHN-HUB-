-- ================= FIX LAG =================
local DecorKeywords = {
	"decor", "decoration", "foliage", "grass", "bush", "shrub", "tree", "leaf", "leaves",
	"prop", "props", "furniture", "trash", "debris", "vegetation", "flower", "rock", "pebble",
	"effect", "fx", "particle", "spark", "smoke", "cloud",
}

local function isInsidePlayerCharacter(obj)
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character and obj:IsDescendantOf(plr.Character) then
			return true
		end
	end
	return false
end

local function hasDecorAncestor(obj)
	local cur = obj.Parent
	while cur and cur ~= workspace do
		local lower = string.lower(cur.Name)
		for _, kw in ipairs(DecorKeywords) do
			if string.find(lower, kw, 1, true) then
				return true
			end
		end
		cur = cur.Parent
	end
	return false
end

local function isSmallDecorPart(part)
	if isInsidePlayerCharacter(part) then return false end
	local nameLower = string.lower(part.Name)
	if nameLower == "humanoidrootpart" or nameLower == "head" or nameLower == "baseplate" then
		return false
	end

	local maxAxis = math.max(part.Size.X, part.Size.Y, part.Size.Z)
	if hasDecorAncestor(part) and (not part.CanCollide or maxAxis <= Config.DecorMaxSize * 2) then
		return true
	end
	if (not part.CanCollide) and maxAxis <= Config.DecorMaxSize then
		return true
	end
	return false
end

local function optimizeObject(obj, backup)
	if not obj or not obj.Parent then return end

	if Config.DisableHeavyLight then
		if obj:IsA("PostEffect") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
			if backup.Light[obj] == nil then backup.Light[obj] = obj.Enabled end
			pcall(function() obj.Enabled = false end)
			return
		elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
			if backup.Light[obj] == nil then backup.Light[obj] = obj.Enabled end
			pcall(function() obj.Enabled = false end)
			return
		end
	end

	if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
		or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
		if backup.Particles[obj] == nil then backup.Particles[obj] = obj.Enabled end
		pcall(function() obj.Enabled = false end)
	elseif obj:IsA("Decal") or obj:IsA("Texture") then
		if backup.Decals[obj] == nil then backup.Decals[obj] = obj.Transparency end
		pcall(function() obj.Transparency = 1 end)
	elseif obj:IsA("BasePart") then
		if Config.HideSmallDecor and isSmallDecorPart(obj) then
			if backup.Hidden[obj] == nil then
				backup.Hidden[obj] = {
					LTM = obj.LocalTransparencyModifier,
					CastShadow = obj.CastShadow,
				}
			end
			pcall(function()
				obj.LocalTransparencyModifier = 1
				obj.CastShadow = false
			end)
		else
			if Config.SimplifyMaterials and not isInsidePlayerCharacter(obj) then
				if backup.Parts[obj] == nil then
					backup.Parts[obj] = {
						Material = obj.Material,
						CastShadow = obj.CastShadow,
					}
				end
				pcall(function()
					obj.Material = Enum.Material.SmoothPlastic
					obj.CastShadow = false
				end)
			elseif backup.Parts[obj] == nil then
				backup.Parts[obj] = {
					Material = obj.Material,
					CastShadow = obj.CastShadow,
				}
				pcall(function() obj.CastShadow = false end)
			end
		end
	end
end

local function applyFixLag(enabled)
	if State.LagAddedConn then
		State.LagAddedConn:Disconnect()
		State.LagAddedConn = nil
	end

	if enabled then
		if not State.LagBackup then
			State.LagBackup = {
				GlobalShadows = Lighting.GlobalShadows,
				EnvSpec = Lighting.EnvironmentSpecularScale,
				EnvDiff = Lighting.EnvironmentDiffuseScale,
				Brightness = Lighting.Brightness,
				Technology = nil,
				Decoration = nil,
				Particles = {},
				Decals = {},
				Light = {},
				Hidden = {},
				Parts = {},
			}
		end
		local backup = State.LagBackup

		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.EnvironmentSpecularScale = 0
			Lighting.EnvironmentDiffuseScale = 0
			if Config.DisableHeavyLight then
				Lighting.Brightness = math.min(Lighting.Brightness, 1.5)
				if backup.Technology == nil then backup.Technology = Lighting.Technology end
				Lighting.Technology = Enum.Technology.Compatibility
			end
		end)

		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			pcall(function()
				if backup.Decoration == nil then backup.Decoration = terrain.Decoration end
				terrain.Decoration = false
			end)
		end

		if Config.DisableHeavyLight then
			for _, child in ipairs(Lighting:GetChildren()) do
				optimizeObject(child, backup)
			end
		end
		for _, obj in ipairs(workspace:GetDescendants()) do
			optimizeObject(obj, backup)
		end

		State.LagAddedConn = trackConn(workspace.DescendantAdded:Connect(function(desc)
			if Config.FixLagEnabled and State.LagBackup then
				task.defer(function()
					if Config.FixLagEnabled and State.LagBackup then
						optimizeObject(desc, State.LagBackup)
					end
				end)
			end
		end))
	else
		local backup = State.LagBackup
		if not backup then return end

		pcall(function()
			Lighting.GlobalShadows = backup.GlobalShadows
			Lighting.EnvironmentSpecularScale = backup.EnvSpec
			Lighting.EnvironmentDiffuseScale = backup.EnvDiff
			Lighting.Brightness = backup.Brightness
			if backup.Technology then Lighting.Technology = backup.Technology end
		end)

		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if terrain and backup.Decoration ~= nil then
			pcall(function() terrain.Decoration = backup.Decoration end)
		end

		for obj, was in pairs(backup.Light) do
			if obj and obj.Parent then pcall(function() obj.Enabled = was end) end
		end
		for obj, was in pairs(backup.Particles) do
			if obj and obj.Parent then pcall(function() obj.Enabled = was end) end
		end
		for obj, oldT in pairs(backup.Decals) do
			if obj and obj.Parent then pcall(function() obj.Transparency = oldT end) end
		end
		for part, pb in pairs(backup.Hidden) do
			if part and part.Parent then
				pcall(function()
					part.LocalTransparencyModifier = pb.LTM
					part.CastShadow = pb.CastShadow
				end)
			end
		end
		for part, pb in pairs(backup.Parts) do
			if part and part.Parent then
				pcall(function()
					part.Material = pb.Material
					part.CastShadow = pb.CastShadow
				end)
			end
		end

		State.LagBackup = nil
	end
end

if Config.FixLagEnabled then
	task.defer(function() applyFixLag(true) end)
end

-- ================= ENTITY SCANNER =================
local CachedEntities = {}
local lastEntityScan = 0
local ENTITY_SCAN_INTERVAL = 0.15

trackConn(workspace.DescendantAdded:Connect(function(desc)
	if desc:IsA("Humanoid") or desc:IsA("Model") then
		State.DirtyEntities = true
	end
end))
trackConn(workspace.DescendantRemoving:Connect(function(desc)
	if desc:IsA("Humanoid") or desc:IsA("Model") then
		State.DirtyEntities = true
	end
end))

local function getAimPart(char)
	if not char or not char.Parent then return nil end
	if Config.AimPart == "HumanoidRootPart" then
		return char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("Head")
	elseif Config.AimPart == "Torso" then
		return char:FindFirstChild("UpperTorso")
			or char:FindFirstChild("Torso")
			or char:FindFirstChild("HumanoidRootPart")
			or char:FindFirstChild("Head")
	end
	return char:FindFirstChild("Head")
		or char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
end

local function getAnchorRoot(char)
	if not char or not char.Parent then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("Head")
		or char:FindFirstChildWhichIsA("BasePart", true)
end

local function isEntityValid(entity)
	if not entity or not entity.Char or not entity.Char.Parent then return false end
	if LocalPlayer.Character and entity.Char == LocalPlayer.Character then return false end

	local hum = entity.Hum
	if hum and hum.Parent then
		if hum.Health <= 0 then return false end
	end

	local aimPart = getAimPart(entity.Char)
	local rootPart = getAnchorRoot(entity.Char)
	return aimPart ~= nil and rootPart ~= nil
end

local function refreshEntities(force)
	local now = os.clock()
	local shouldScan = force or State.DirtyEntities or ((now - lastEntityScan) >= ENTITY_SCAN_INTERVAL)
	if not shouldScan then
		return CachedEntities
	end
	lastEntityScan = now
	State.DirtyEntities = false

	local list = {}
	local seenChars = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character and plr.Character.Parent then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			list[#list + 1] = {
				Key = plr,
				Player = plr,
				Char = plr.Character,
				Hum = hum,
				Name = plr.DisplayName or plr.Name,
			}
			seenChars[plr.Character] = true
		end
	end

	local cam = getCamera()
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") then
			local char = obj.Parent
			if not seenChars[char] and char ~= LocalPlayer.Character and obj.Health > 0 then
				local root = getAnchorRoot(char)
				if root and (root.Position - camPos).Magnitude <= Config.ESPMaxDist then
					list[#list + 1] = {
						Key = char,
						Player = nil,
						Char = char,
						Hum = obj,
						Name = char.Name,
					}
					seenChars[char] = true
				end
			end
		end
	end

	CachedEntities = list
	return CachedEntities
end

-- ================= AIMBOT =================
local function isVisible(targetPart, targetChar)
	local camera = getCamera()
	if not camera or not targetPart then return false end

	local origin = camera.CFrame.Position
	local goalPos = targetPart.Position
	local delta = goalPos - origin
	local dist = delta.Magnitude
	if dist <= 0.1 then return true end

	local direction = delta
	local ignoreList = {}
	if LocalPlayer.Character then table.insert(ignoreList, LocalPlayer.Character) end
	if targetChar then table.insert(ignoreList, targetChar) end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true
	params.FilterDescendantsInstances = ignoreList

	for _ = 1, 6 do
		local result = work
