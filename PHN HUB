local function HopServer()
    Hop.Text = "🔎 ĐANG TÌM..."

    local Success, Result = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if not Success or not Result or not Result.data then
        Hop.Text = "❌ LỖI"
        task.wait(2)
        Hop.Text = "👥 HOP SERVER 1–2 NGƯỜI"
        return
    end

    local Targets = {}

    -- Ưu tiên server 1-2 người
    for _, Server in ipairs(Result.data) do
        if Server.id ~= game.JobId
        and Server.playing >= 1
        and Server.playing <= 2
        and Server.playing < Server.maxPlayers then
            table.insert(Targets, Server)
        end
    end

    if #Targets > 0 then
        local Target = Targets[math.random(1, #Targets)]

        Hop.Text = "🚀 ĐANG VÀO..."

        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            Target.id,
            Player
        )
    else
        -- Nếu không có server 1-2 người
        -- chọn server ít người nhất
        local Fallback

        for _, Server in ipairs(Result.data) do
            if Server.id ~= game.JobId
            and Server.playing < Server.maxPlayers then

                if not Fallback
                or Server.playing < Fallback.playing then
                    Fallback = Server
                end
            end
        end

        if Fallback then
            Hop.Text = "🔄 ĐANG VÀO SERVER ÍT NGƯỜI..."

            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                Fallback.id,
                Player
            )
        else
            Hop.Text = "❌ KHÔNG TÌM THẤY SERVER"
            task.wait(2)
            Hop.Text = "👥 HOP SERVER 1–2 NGƯỜI"
        end
    end
end

Hop.MouseButton1Click:Connect(HopServer)

print("💗 PHN HUB LOADED")
