	LockedTargetChar = nil
	LockedTargetPlr = nil
end

local function IsTargetSeenByCamera(char, part)
	if not char or not char.Parent or not part or not part.Parent then
		return false
	end
	local origin = Camera.CFrame.Position
	local delta = part.Position - origin
	if delta.Magnitude <= 0.05 then return true end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	if LocalPlayer.Character then table.insert(ex, LocalPlayer.Character) end
	table.insert(ex, char)
	params.FilterDescendantsInstances = ex
	params.IgnoreWater = true

	return Workspace:Raycast(origin, delta.Unit * delta.Magnitude, params) == nil
end

local function ComputeBehindPosition(targetHrp)
	local look = targetHrp.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end
	return targetHrp.Position - flatLook * State.BehindDistance
end

local function GetAimPart(char)
	if not char then return nil end
	if State.AimPart == "HRP" then
		return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head")
	end
	return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
end

local function ShouldIgnorePlayer(plr)
	return not plr or plr == LocalPlayer
end

