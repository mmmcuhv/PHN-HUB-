local function HideSkeleton(plr)
	local lines = SkeletonMap[plr]
	if not lines then return end
	pcall(function()
		for _, ln in ipairs(lines) do
			ln.Visible = false
		end
	end)
end

local function ClearSkeleton(plr)
	local lines = SkeletonMap[plr]
	if not lines then return end
	pcall(function()
		for _, ln in ipairs(lines) do
			ln:Remove()
		end
	end)
	SkeletonMap[plr] = nil
end

local function GetSkeletonLines(plr)
	if not HasDrawing then return nil end
	if SkeletonMap[plr] then return SkeletonMap[plr] end
	local ok, created = pcall(function()
		local arr = {}
		for i = 1, #SKELETON_BONES do
			local ln = Drawing.new("Line")
			ln.Thickness = SKELETON_THICKNESS
			ln.Color = SKELETON_WHITE
			ln.Visible = false
			arr[i] = ln
		end
		return arr
	end)
	if ok and created then
		SkeletonMap[plr] = created
		return created
	end
	return nil
end

local function UpdateSkeleton(plr, char, enabled)
	if not enabled or not HasDrawing or not char or not char.Parent then
		HideSkeleton(plr)
		return
	end
	local lines = GetSkeletonLines(plr)
	if not lines then return end

	pcall(function()
		for i, bone in ipairs(SKELETON_BONES) do
			local ln = lines[i]
			local pA = char:FindFirstChild(bone[1])
			local pB = char:FindFirstChild(bone[2])
			if pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
				local spA, visA = Camera:WorldToViewportPoint(pA.Position)
				local spB, visB = Camera:WorldToViewportPoint(pB.Position)
				if (visA or visB) and spA.Z > 0 and spB.Z > 0 then
					ln.From = Vector2.new(spA.X, spA.Y)
					ln.To = Vector2.new(spB.X, spB.Y)
					ln.Thickness = SKELETON_THICKNESS
					ln.Color = SKELETON_WHITE
					ln.Visible = true
				else
					ln.Visible = false
				end
			else
				ln.Visible = false
			end
		end
	end)
end

local function HideESP(e)
	if not e then return end
	pcall(function()
		if e.Box then e.Box.Visible = false end
		if e.Line then e.Line.Visible = false end
	end)
end

local function ClearESP(plr)
	local e = ESPMap[plr]
	if e then
		pcall(function()
			if e.Box then e.Box:Remove() end
			if e.Line then e.Line:Remove() end
		end)
		ESPMap[plr] = nil
	end
	ClearSkeleton(plr)
end

local function GetESP(plr)
	if not HasDrawing then return nil end
	if ESPMap[plr] then return ESPMap[plr] end
	local ok, res = pcall(function()
		local box = Drawing.new("Square")
		box.Thickness = 1.8
		box.Filled = false
		box.Color = ESP_WHITE_BOLD
		box.Visible = false

		local line = Drawing.new("Line")
		line.Thickness = 1.7
		line.Color = ESP_WHITE_BOLD
		line.Visible = false

		return { Box = box, Line = line }
	end)
	if ok and res then
		ESPMap[plr] = res
		return res
	end
	return nil
end

local function IsVisible(char, part)
	if not State.WallCheck then return true end
	return IsTargetSeenByCamera(char, part)
end

local function IsTargetValidForLock(plr, char, part, ignoreWall, maxRadius, center)
	if ShouldIgnorePlayer(plr) then
		return false
	end
	if not char or not char.Parent or not part or not part.Parent then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	local preferredPart = GetAimPart(char)
	if preferredPart and part ~= preferredPart then
		part = preferredPart
		LockedTargetPart = preferredPart
	end
	if not ignoreWall and not IsVisible(char, part) then
		return false
	end
	if center and maxRadius then
		local sp, vis = Camera:WorldToViewportPoint(part.Position)
		if not vis or sp.Z <= 0 then
			return false
		end
		if (Vector2.new(sp.X, sp.Y) - center).Magnitude > maxRadius then
			return false
		end
	end
	return true
end

local function FindTargetInFOV(center)
	if State.StickyLock and IsTargetValidForLock(LockedTargetPlr, LockedTargetChar, LockedTargetPart, false, State.FOVRadius, center) then
		return LockedTargetPart
	end
	ClearLockedTarget()

	local bestPart = nil
	local bestChar = nil
	local bestPlr = nil
	local bestDist = State.FOVRadius

	for _, plr in ipairs(Players:GetPlayers()) do
		if not ShouldIgnorePlayer(plr) and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local part = GetAimPart(plr.Character)
			if hum and hum.Health > 0 and part then
				local sp, vis = Camera:WorldToViewportPoint(part.Position)
				if vis and sp.Z > 0 then
					local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					if d <= bestDist and IsVisible(plr.Character, part) then
						bestDist = d
						bestPart = part
						bestChar = plr.Character
						bestPlr = plr
					end
				end
			end
		end
	end

	if bestPart and State.StickyLock then
		LockedTargetPart = bestPart
		LockedTargetChar = bestChar
		LockedTargetPlr = bestPlr
	end
	return bestPart
end

local function FindNearestMapTarget(ignoreWall)
	if State.StickyLock and IsTargetValidForLock(LockedTargetPlr, LockedTargetChar, LockedTargetPart, ignoreWall, nil, nil) then
		local lHrp = LockedTargetChar:FindFirstChild("HumanoidRootPart") or LockedTargetChar:FindFirstChild("Head")
		if lHrp then
			return LockedTargetPlr, LockedTargetChar, lHrp, LockedTargetPart
		end
	end
	ClearLockedTarget()

	local myChar = LocalPlayer.Character
	local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
	if not myHrp then return nil, nil, nil, nil end

	local bestPlr, bestChar, bestHrp, bestAimPart = nil, nil, nil, nil
	local nearestDist = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if not ShouldIgnorePlayer(plr) and plr.Character then
			local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
			local pHrp = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
			local pAim = GetAimPart(plr.Character)
			if pHum and pHum.Health > 0 and pHrp and pAim then
				if ignoreWall or IsVisible(plr.Character, pAim) then
					local d = (pHrp.Position - myHrp.Position).Magnitude
					if d < nearestDist then
						nearestDist = d
						bestPlr = plr
						bestChar = plr.Character
						bestHrp = pHrp
						bestAimPart = pAim
					end
				end
			end
		end
	end

	if bestPlr and bestChar and bestHrp and bestAimPart then
		LockedTargetPlr = bestPlr
		LockedTargetChar = bestChar
		LockedTargetPart = bestAimPart
		return bestPlr, bestChar, bestHrp, bestAimPart
	end

	return nil, nil, nil, nil
end

local function GetBehindTarget()
	return FindNearestMapTarget(true)
end

